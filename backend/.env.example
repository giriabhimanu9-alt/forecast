# Copy to backend/.env and edit. Real environment variables override this file.

# ---- storage ---------------------------------------------------------------
DATA_DIR=./data                 # relative paths resolve against backend/

# ---- common target grid (India) --------------------------------------------
TARGET_REGION_NAME=India
TARGET_LAT_MIN=5
TARGET_LAT_MAX=38
TARGET_LON_MIN=68
TARGET_LON_MAX=98
TARGET_GRID_RESOLUTION=0.25

# ---- forecasts --------------------------------------------------------------
VARIABLES=precipitation,temperature_2m,wind_speed_10m
FORECAST_INIT_TIME=latest       # or e.g. 2026-09-27T00 (UTC)
FORECAST_LEAD_HOURS=6-72/6      # or a list: 24,48,72  (lead 0 not allowed)
LATEST_SEARCH_CYCLES=4

ENABLE_GFS=true
GFS_BASE_URL=https://noaa-gfs-bdp-pds.s3.amazonaws.com

ENABLE_ECMWF=true
# data.ecmwf.int keeps ~4 days; for older cycles use the AWS mirror:
# ECMWF_BASE_URL=https://ecmwf-forecasts.s3.eu-central-1.amazonaws.com
ECMWF_BASE_URL=https://data.ecmwf.int/forecasts

# ---- observations (IMD gridded rainfall) ------------------------------------
ENABLE_OBSERVATIONS=true
IMD_SOURCE=auto                 # auto | realtime | archive
# Leave both empty to use the last IMD_LOOKBACK_DAYS days (ending 2 days ago)
IMD_START_DATE=
IMD_END_DATE=
IMD_LOOKBACK_DAYS=7

# ---- AI model plug-in (empty = interface only) ------------------------------
AI_MODEL_PROVIDER=

# ---- misc -------------------------------------------------------------------
HTTP_TIMEOUT=120
HTTP_RETRIES=3
LOG_LEVEL=INFO
